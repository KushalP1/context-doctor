{
  "name": "context-doctor",
  "version": "0.40.0",
  "description": "Context and token optimizer for LLM agents: see where Claude Code, Cursor, Codex and Gemini CLI tokens go, then cut them: an every-prompt hook, smarter compaction, an autopilot proxy that edits history only when the prompt cache is cold, RAG chunk packing and an MCP server. Local, no API key. By gAI Ventures.",
  "keywords": [
    "agent",
    "ai-agents",
    "ai-tools",
    "anthropic",
    "anthropic-sdk",
    "autocompact",
    "chunking",
    "claude",
    "claude-code",
    "claude-desktop",
    "codex",
    "compaction",
    "context-compression",
    "context-engineering",
    "context-management",
    "context-window",
    "cost",
    "cursor",
    "developer-tools",
    "gemini",
    "gemini-cli",
    "gpt",
    "llm",
    "llm-cost",
    "llm-tools",
    "mcp",
    "model-context-protocol",
    "openai",
    "openai-sdk",
    "prompt-cache",
    "prompt-caching",
    "prompt-engineering",
    "proxy",
    "rag",
    "token-counter",
    "token-optimization",
    "token-usage",
    "tokens"
  ],
  "license": "MIT",
  "author": "gAI Ventures (https://gai.ventures)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KushalP1/context-doctor.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "context-doctor": "dist/cli.js",
    "ctx-doctor": "dist/cli.js",
    "context-doctor-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "!dist/test",
    "!dist/mcp.bundle.js",
    "!dist/mcpclient.d.ts",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node scripts/bundle-mcp.mjs && node -e \"const fs=require('fs');['dist/cli.js','dist/mcp.js'].forEach(f=>fs.chmodSync(f,0o755))\"",
    "prepublishOnly": "npm test",
    "dev": "tsc --watch",
    "test": "npm run build && node scripts/test.mjs",
    "build:mcpb": "npm run build && node scripts/build-mcpb.mjs",
    "version": "node scripts/sync-versions.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.23.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.5.0"
  },
  "homepage": "https://github.com/KushalP1/context-doctor#readme",
  "bugs": {
    "url": "https://github.com/KushalP1/context-doctor/issues"
  },
  "mcpName": "io.github.KushalP1/context-doctor"
}
