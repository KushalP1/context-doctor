{
  "name": "context-doctor",
  "version": "0.20.0",
  "description": "Keep AI coding sessions lean automatically: clears stale tool output from every Claude Code and GPT API request, only when it costs nothing extra (measured 9.8% less input, no session worse). Token profiler, hooks and MCP tools for Claude Code, Cursor, Codex and Claude Desktop.",
  "keywords": [
    "agent",
    "ai-agents",
    "anthropic",
    "autocompact",
    "claude",
    "claude-code",
    "claude-desktop",
    "codex",
    "context-engineering",
    "context-management",
    "context-window",
    "cost",
    "cursor",
    "developer-tools",
    "gpt",
    "llm",
    "llm-cost",
    "mcp",
    "model-context-protocol",
    "openai",
    "prompt-caching",
    "prompt-engineering",
    "proxy",
    "token-usage",
    "tokens"
  ],
  "license": "MIT",
  "author": "gAI Ventures (https://gai.ventures)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KushalP1/context-doctor.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "context-doctor": "dist/cli.js",
    "ctx-doctor": "dist/cli.js",
    "context-doctor-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "!dist/test",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');['dist/cli.js','dist/mcp.js'].forEach(f=>fs.chmodSync(f,0o755))\"",
    "prepublishOnly": "npm test",
    "dev": "tsc --watch",
    "test": "npm run build && node scripts/test.mjs",
    "build:mcpb": "npm run build && node scripts/build-mcpb.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "homepage": "https://github.com/KushalP1/context-doctor#readme",
  "bugs": {
    "url": "https://github.com/KushalP1/context-doctor/issues"
  }
}
