{
  "name": "context-doctor",
  "version": "0.38.0",
  "description": "Cut your Claude Code bill, measured on your own sessions: /context-doctor:fix ranks every fix by what it would have saved you and applies the ones you choose (reversibly), /context-doctor:savings shows the dollars, and an every-prompt check names the waste.",
  "author": {
    "name": "gAI Ventures",
    "url": "https://gai.ventures"
  },
  "homepage": "https://github.com/KushalP1/context-doctor#readme",
  "repository": "https://github.com/KushalP1/context-doctor",
  "license": "MIT",
  "keywords": [
    "context",
    "tokens",
    "cost",
    "prompt-caching",
    "context-window",
    "autopilot",
    "hooks",
    "mcp"
  ],
  "skills": "./plugin/skills",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/cli.js\" hook"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/cli.js\" hook"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/cli.js\" hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/cli.js\" hook",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "context-doctor": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/dist/mcp.bundle.js"
      ]
    }
  }
}
